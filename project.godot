; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="asideness"
run/main_scene="uid://c7wjlqf4cn6il"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://csg8ta1k0ieyj"

[autoload]

SceneManager="*uid://j20v4cg7v8m1"

[display]

window/size/mode=1
window/size/initial_position_type=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gd-blender-3d-shortcuts/plugin.cfg", "res://addons/godot_gif/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/ridiculous_coding/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/size/initial_position_type=1
anti_aliasing/size/mode=0
